# ── Frontend (Vite, safe to expose) ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyADBrbVMU-C13MTUV-Xn0Idt_J_kG7G7GU
VITE_FIREBASE_AUTH_DOMAIN=atll-25c8b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=atll-25c8b
VITE_FIREBASE_STORAGE_BUCKET=atll-25c8b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=363607593222
VITE_FIREBASE_APP_ID=1:363607593222:web:5f9fe4a9ac16a223d68e87

# ── Backend (server only, never prefixed with VITE_) ─────────────────────────

# MySQL. Local dev example; swap for the school's host once IT confirms it.
DATABASE_URL=mysql://atl:devpassword@localhost:3306/atl_nexus
DB_POOL_SIZE=4

# Firebase Admin service account, as a single-line JSON string.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Optional. Once the school confirms everyone is on a Workspace domain, set this
# and sign-in is refused for any address outside it, even if somebody adds one
# to the roster by mistake. Leave blank while accounts are mixed.
ALLOWED_EMAIL_DOMAIN=

# Invite emails. Resend free tier covers 3000/month.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
APP_URL=http://localhost:5173

# ── Local development only ──────────────────────────────────────────────────
# Lets you click through the app before the Firebase service-account key
# exists. Every request is treated as this roster email, and the in-app
# switcher (bottom right) changes it per browser tab.
#
# Both lines are development-only and cannot reach production: VITE_DEV_LOGIN
# is behind import.meta.env.DEV, and the API side runs in dev-server.mjs, which
# Vercel never executes. Delete both once you have the real key.
VITE_DEV_LOGIN=1
DEV_LOGIN_AS=r.mehta@example.edu
