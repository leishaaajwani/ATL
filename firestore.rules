rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserRole() == 'student';
    }

    // ── Users collection ─────────────────────────────────────────────────────

    match /users/{uid} {
      // Anyone authenticated can read their own doc; teachers can read all
      allow read: if isSignedIn() && (isOwner(uid) || isTeacher());

      // Users create/update their own doc (set during sign-in)
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isSignedIn() && (
        // User updates their own non-role fields
        (isOwner(uid) && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
        // Teachers can change roles
        || isTeacher()
      );
    }

    // ── ATL Entries ──────────────────────────────────────────────────────────

    match /atl_entries/{entryId} {

      // Students read only their own entries; teachers read all
      allow read: if isSignedIn() && (
        isTeacher()
        || (isStudent() && resource.data.studentId == request.auth.uid)
      );

      // Students create entries for themselves only
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.reflection.size() >= 80
        && request.resource.data.reflection.size() <= 500;

      // Students can update only their own pending entries (not approval fields)
      allow update: if (
        isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.approvalStatus == 'pending'
        && !('approvalStatus' in request.resource.data.diff(resource.data).affectedKeys())
        && !('teacherFeedback' in request.resource.data.diff(resource.data).affectedKeys())
        && !('teacherScore' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isTeacher();

      // Students cannot delete; teachers can
      allow delete: if isTeacher();
    }

    // ── Class sections & enrollments (read-only for students) ────────────────

    match /class_sections/{sectionId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    match /enrollments/{enrollmentId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // ── ATL skills reference data ─────────────────────────────────────────────

    match /atl_skills/{skillId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // ── Subjects reference data ───────────────────────────────────────────────

    match /subjects/{subjectId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }
  }
}
